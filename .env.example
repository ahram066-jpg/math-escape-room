# Supabase 프로젝트 설정에서 확인할 수 있습니다.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 반드시 서버 전용 비밀키(sb_secret_...)를 사용하세요.
# 브라우저 코드나 GitHub에는 실제 값을 올리지 마세요.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# supabase: Supabase에만 저장
# dual: Supabase와 기존 Sites D1에 함께 저장(이관 확인용)
# d1: 기존 Sites D1에만 저장
RESULTS_STORAGE=supabase

# 교사용 대시보드(/teacher) 접속 비밀번호입니다.
# 실제 값은 배포 환경 변수에만 등록하세요.
TEACHER_PIN=REPLACE_WITH_A_PRIVATE_PIN
